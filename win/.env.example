# =====================================================
# 吉米·智驱 (Jimi Agent) 配置文件模板
# 使用方法：将此文件复制并重命名为 .env，然后填写以下参数
# =====================================================

# --- 🔑 网关访问令牌（登录密钥，保持默认即可）---
OPENCLAW_GATEWAY_TOKEN=Jimi_Agent_2026

# --- 🧠 AI 大脑 API Key (DeepSeek 通道) ---
# 使用官方 DeepSeek 通道
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# --- 🧠 备用模型通道 (Agnes) ---
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# AGNES_API_KEY=

# --- 🧠 API易 通道 (可选，供 nano-banana-pro 模型使用) ---
APIYI_BASE_URL=https://api.apiyi.com/v1
APIYI_API_KEY=

# --- 🧠 模型选择路由 ---
# 默认配置（给客户安装时，请使用官方 DeepSeek 及正确的备用/备灾模型）
PRIMARY_MODEL=deepseek/deepseek-v4-flash
FALLBACK_MODEL_1=deepseek/deepseek-flash
FALLBACK_MODEL_2=deepseek/deepseek-v4-pro


# --- 🧠 记忆系统向量嵌入 (Embedding) 接口配置 (LanceDB 驱动) ---
# ⚠️ 注意：记忆向量模型是必须配置的（若为空，记忆功能会报错失效）。
# 推荐使用国内免代理的 SiliconFlow (硅基流动) 通道，响应速度极快，且有免费额度。
# 硅基流动官网：https://siliconflow.cn
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIMENSIONS=1024

# 💡 客户自备 Zhipu AI (智谱) 嵌入接口时的配置：
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDING_MODEL=embedding-3
# EMBEDDING_DIMENSIONS=1536

# 💡 客户自备 Aliyun (阿里云百炼) 嵌入接口时的配置：
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_DIMENSIONS=1536

# 💡 客户自备 OpenAI / 代理接口时的配置：
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=https://api.openai.com/v1 (或第三方中转)
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536


# --- 🔍 网络检索 (Web Search) 接口配置 ---
# 启用搜索的插件，可选值: tavily, brave, duckduckgo (免 Key 实验版)
SEARCH_PROVIDER=brave

# Tavily 搜索配置 (推荐用于 AI 摘要检索，前往 https://tavily.com 获取 API Key)
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# Brave Search 搜索配置 (可选，前往 https://brave.com/search/api 获取 API Key)
BRAVE_API_KEY=


# =============================================================
# 💻 硬件性能全量适配表 — 根据你的电脑物理总内存选择对应行配置
# =============================================================
#
#  电脑物理内存 │ MEM_LIMIT │ MEM_RESERVATION │ NODE_MEM_LIMIT │ FFMPEG_THREADS │ MAX_PAYLOAD_SIZE
#  ──────────┼───────────┼─────────────────┼────────────────┼────────────────┼─────────────────
#   8  GB    │    4g     │       1g        │      2560      │       2        │      100M
#   16 GB    │    8g     │       2g        │      6144      │       4        │      200M   ← 主流默认
#   24 GB    │   12g     │       3g        │      8192      │       6        │      200M
#   32 GB    │   16g     │       4g        │     12288      │       8        │      300M
#   40 GB    │   24g     │       6g        │     16384      │       8        │      300M
#   48 GB    │   32g     │       8g        │     20480      │     8 ~ 12     │      500M
#   64 GB+   │   40g     │       8g        │     28672      │     8 ~ 16     │      500M
#
#  【核心参数全面说明】：
#    MEM_LIMIT       : Docker 容器最大可用内存上限（建议给 Windows/Mac 宿主机留出 3~4G 空间，严禁分配过满）。
#    MEM_RESERVATION : 容器保证获得的最低基础内存（通常为 MEM_LIMIT 的约 25%）。
#    NODE_MEM_LIMIT  : Node.js 网关堆内存上限（MB，约为 MEM_LIMIT 的 60%~70%）。系统启动脚本会自动将其与 --max-old-space-size 同步，无需手动拼写。
#    FFMPEG_THREADS  : 视频与音频处理线程数（取决于 CPU 物理核心数，不超过核心数）。8G 电脑请务必设为 2；多核高配电脑可设 8~12。
#    MAX_PAYLOAD_SIZE: 允许传输/上传的文件与 Payload 大小限制（如 PDF、视频等），防止 WebSocket/HTTP 网关异常断连 (1009/1006)。
#    NODE_OPTIONS    : (高级可选) 默认留空即可，启动脚本会自动合成 --max-old-space-size 与 --max-http-header-size=102400。如需增加其他 V8 调试参数可在此填入。
#
#  【Windows 8G 内存电脑特别注意】：
#    1. Windows 自身开机就会占用约 3.5GB ~ 4GB 内存。
#    2. 部署前建议在 Windows 用户目录创建或编辑 %USERPROFILE%\.wslconfig（限制 WSL2 内存）：
#       [wsl2]
#       memory=5GB
#       swap=4GB
#    3. 8G 电脑请务必使用 8G 对应配置：MEM_LIMIT=4g, MEM_RESERVATION=1g, NODE_MEM_LIMIT=2560, FFMPEG_THREADS=2, MAX_PAYLOAD_SIZE=100M。
# =============================================================

# 👇 默认推荐配置：适合 16G 内存电脑。若是 8G/32G 电脑，请参考上表修改对应数值：
MEM_LIMIT=8g
MEM_RESERVATION=2g
NODE_MEM_LIMIT=6144
FFMPEG_THREADS=4

# --- 🐳 Docker 镜像与 OpenClaw 版本配置（全局单一真值源）---
# 💡 提示：若升级版本（如升级到 2026.10.6），只需修改下方的 IMAGE_TAG：
#    - 运行 ./release.sh (或 release.bat / release.ps1) 时：会自动提取此处版本构建镜像，并自动对齐 Dockerfile 中的版本参数
#    - 运行 docker compose up 时：会自动拉取并启动对应版本的容器镜像
IMAGE_TAG=2026.10.6

# 上传大文件与请求 Payload 大小限制
MAX_PAYLOAD_SIZE=200M
# Node.js 额外选项（高级可选，留空即可由系统自适应合成）
NODE_OPTIONS=


# --- 🎥 高级视频/数字人技能配置 (Volcano Engine - 可选) ---
# 以下配置用于 fashion-video-pipeline 等高级自定义视频/数字人技能，如果不使用可以不填。
#
# VOLC_ARK_API_KEY= (火山引擎 Ark 大模型平台 API Key，用于调用大模型及各种推理服务)
# VOLC_TTS_API_KEY= (火山引擎语音合成/配音服务的 API Key，用于给视频自动生成高品质旁白配音)
#
# 💡 接入点说明：需要在火山引擎 Ark 平台控制台针对对应模型创建接入点，并填入形如 ep-xxxxxx-xxxxxx 的 ID：
# VOLC_VIDEO_GEN_ENDPOINT= (Seedance 2.0 标准高画质版视频生成接入点，用于生成 15s 服装/时尚主视频)
# VOLC_VIDEO_GEN_MINI_ENDPOINT= (Seedance 2.0 Mini极速调试版视频生成接入点，速度快 2-3 倍，用于快速预览和 Prompt 调试)
# VOLC_IMAGE_GEN_ENDPOINT= (Seedream 5.0 图像生成接入点，用于文生图、图生图或生成服装模特底图)
# VOLC_VISION_ENDPOINT= (Doubao-vision 多模态视觉大模型接入点，用于看图/画质把关、画面内容质检与反思)
# VOLC_EMBEDDING_VISION_ENDPOINT= (Doubao-embedding-vision 视觉向量大模型接入点，用于多模态图片检索与 RAG 数据存取)

# --- 🎥 Shotstack 视频时间轴渲染接口配置 (可选) ---
# 用于 shotstack-edit-v1 批量生成短视频技能
# 前往 https://shotstack.io 注册并获取 API Key
SHOTSTACK_API_KEY=