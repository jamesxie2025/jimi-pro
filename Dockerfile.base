# ==============================================================================
# 吉米·智驱 Ultra Pro - 底层满血算力底座构建文件 (Dockerfile.base)
# ==============================================================================
# 用途说明：
# 本文件仅在需要“从零重构底层 Debian 系统库 / 新增 Python AI 依赖包”时使用。
# 日常升级 OpenClaw 版本（如 2026.10.1 -> 2026.10.2）或更新 skills / entrypoint.sh 时，
# 请直接使用默认的 Dockerfile（基于 :base-env 极速热升级，无需重装任何依赖）。
# ==============================================================================
ARG OPENCLAW_VER=2026.10.1
FROM ghcr.io/openclaw/openclaw:${OPENCLAW_VER}

USER root
ARG USE_CN_MIRRORS=1

# 1. 环境变量与全路径对齐 (8线程满血 + 限制 uv 并发数为 8 防止镜像站 429 限流)
ENV TZ=Asia/Shanghai \
    MAX_PAYLOAD_SIZE=200M \
    NODE_OPTIONS="--max-http-header-size=102400" \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PYTHONUNBUFFERED=1 \
    UV_INDEX_URL="https://mirrors.aliyun.com/pypi/simple/" \
    UV_CONCURRENT_DOWNLOADS=8 \
    UV_HTTP_TIMEOUT=120 \
    FFMPEG_THREADS=8 \
    OPENBLAS_NUM_THREADS=8 \
    PLAYWRIGHT_BROWSERS_PATH=/usr/local/share/ms-playwright \
    TORCH_HOME=/root/.cache/torch \
    EASYOCR_MODULE_PATH=/root/.cache/easyocr \
    PADDLEOCR_BASE_DIR=/root/.cache/paddleocr \
    WHISPER_MODEL_CACHE=/root/.openclaw/models/whisper \
    PYTHONPATH="/usr/local/lib/python3.11/dist-packages" \
    PATH="/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/local/lib/python3.11/dist-packages/bin:/root/.local/bin:$PATH" \
    DEBIAN_FRONTEND=noninteractive \
    FS_SAFE_NATIVE_MODE=auto \
    OPENCLAW_FS_SAFE_NATIVE_MODE=auto \
    NODE_COMPILE_CACHE=/var/tmp/openclaw-compile-cache \
    OPENCLAW_NO_RESPAWN=1

# 2. 系统依赖补完 (支持国内中科大源与海外官方源自动切换)
RUN export HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= NO_PROXY="*" no_proxy="*" && \
    echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/99proxy-tuning && \
    echo 'Acquire::http::Timeout "30";' >> /etc/apt/apt.conf.d/99proxy-tuning && \
    echo 'Acquire::http::Pipeline-Depth "0";' >> /etc/apt/apt.conf.d/99proxy-tuning && \
    echo 'Acquire::http::Max-Control-Connections "4";' >> /etc/apt/apt.conf.d/99proxy-tuning && \
    echo 'Acquire::http::Proxy "false";' >> /etc/apt/apt.conf.d/99proxy-tuning && \
    echo 'Acquire::https::Proxy "false";' >> /etc/apt/apt.conf.d/99proxy-tuning && \
    if [ "$USE_CN_MIRRORS" = "1" ]; then \
        find /etc/apt/ -type f -exec sed -i -E "s@https?://(deb.debian.org|mirrors.aliyun.com|mirrors.tuna.tsinghua.edu.cn)@http://mirrors.ustc.edu.cn@g" {} +; \
    fi && \
    apt-get update && apt-get install -y --fix-missing --no-install-recommends \
    build-essential g++ gcc cmake python3-dev python3-pip python3-venv pkg-config ninja-build \
    wget curl zip unzip jq bc tini ffmpeg imagemagick pandoc antiword poppler-utils \
    libcairo2-dev libpng-dev libxml2-dev libxslt1-dev libopenblas-dev liblapack-dev libjpeg-dev zlib1g-dev \
    shared-mime-info libgl1 libglib2.0-0 libpango1.0-dev libharfbuzz-dev libffi-dev \
    graphviz libgraphviz-dev libpq-dev unixodbc-dev \
    fonts-noto-cjk fonts-wqy-zenhei fonts-wqy-microhei \
    fonts-noto-color-emoji fonts-liberation fontconfig ca-certificates openssh-client docker.io && \
    ln -sf /usr/bin/python3 /usr/bin/python && rm -rf /var/lib/apt/lists/*

# 3. 核心 CLI 工具架构对齐安装 (DuckDB + Dreamina)
RUN raw_arch=$(dpkg --print-architecture) && \
    case "$raw_arch" in \
      arm64) duck_arch="aarch64" ;; \
      *)     duck_arch="$raw_arch" ;; \
    esac && \
    (wget --retry-connrefused --tries=3 --timeout=20 -q \
      "https://github.com/duckdb/duckdb/releases/download/v1.1.3/duckdb_cli-linux-${duck_arch}.zip" || \
     wget --no-proxy --retry-connrefused --tries=3 --timeout=20 -q \
      "https://github.com/duckdb/duckdb/releases/download/v1.1.3/duckdb_cli-linux-${duck_arch}.zip") && \
    unzip -o "duckdb_cli-linux-${duck_arch}.zip" -d /usr/local/bin && \
    rm "duckdb_cli-linux-${duck_arch}.zip" && \
    (export HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= && curl --noproxy "*" --retry 5 --retry-delay 3 --retry-all-errors -fsSL -k https://jimeng.jianying.com/cli | bash) || echo "⚠️  Dreamina 安装失败（非致命），跳过" && \
    if [ -f /root/.local/bin/dreamina ]; then \
      cp /root/.local/bin/dreamina /usr/local/bin/dreamina && \
      ln -sf /usr/local/bin/dreamina /usr/local/bin/jimeng; \
    fi

# 4. Python 技能库全量注入
RUN export HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= && \
    if [ "$USE_CN_MIRRORS" = "1" ]; then \
        pip3 install uv -i https://mirrors.aliyun.com/pypi/simple/ --break-system-packages || pip3 install uv --break-system-packages; \
    else \
        pip3 install uv --break-system-packages; \
    fi

# 第一批：通用包
RUN export HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= UV_CONCURRENT_DOWNLOADS=8 UV_HTTP_TIMEOUT=120 && \
    PYPI_URL=$([ "$USE_CN_MIRRORS" = "1" ] && echo "https://mirrors.aliyun.com/pypi/simple/" || echo "https://pypi.org/simple") && \
    uv pip install --system --no-cache --break-system-packages \
    --index-url "$PYPI_URL" \
    "pandas<3.0.0" numpy numexpr polars duckdb pyarrow fastparquet SQLAlchemy \
    psycopg2-binary fasteners pydantic pyxlsb matplotlib seaborn scikit-learn \
    lightgbm statsmodels scipy pandas-ta-classic akshare yfinance chinesecalendar \
    faster-whisper moviepy opencv-python-headless Pillow pydub av edge-tts \
    yt-dlp rich svglib python-slugify beautifulsoup4 lxml requests httpx \
    playwright playwright-stealth weasyprint reportlab pdfplumber pymupdf \
    python-docx python-pptx openpyxl xlsxwriter qrcode pypdf img2pdf \
    loguru watchdog tqdm jinja2 pyecharts python-dotenv cairosvg tavily-python

# 第二批：torch
RUN ARCH=$(dpkg --print-architecture) && \
    if [ "$ARCH" = "amd64" ]; then \
        uv pip install --system --no-cache --break-system-packages \
            torch torchvision --index-url https://download.pytorch.org/whl/cpu; \
    else \
        export HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= UV_CONCURRENT_DOWNLOADS=8 UV_HTTP_TIMEOUT=120 && \
        PYPI_URL=$([ "$USE_CN_MIRRORS" = "1" ] && echo "https://mirrors.aliyun.com/pypi/simple/" || echo "https://pypi.org/simple") && \
        uv pip install --system --no-cache --break-system-packages \
            --index-url "$PYPI_URL" \
            "torch==2.5.1" "torchvision==0.20.1"; \
    fi

# 第三批：AI 工具链
RUN export HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= UV_CONCURRENT_DOWNLOADS=8 UV_HTTP_TIMEOUT=120 && \
    PYPI_URL=$([ "$USE_CN_MIRRORS" = "1" ] && echo "https://mirrors.aliyun.com/pypi/simple/" || echo "https://pypi.org/simple") && \
    uv pip install --system --no-cache --break-system-packages \
    --index-url "$PYPI_URL" \
    "torch<2.6" "torchvision<0.21" \
    unstructured[pdf] docling librosa chromadb easyocr "rembg[cli]"

# 第四批：manim
RUN export HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= UV_CONCURRENT_DOWNLOADS=8 UV_HTTP_TIMEOUT=120 && \
    PYPI_URL=$([ "$USE_CN_MIRRORS" = "1" ] && echo "https://mirrors.aliyun.com/pypi/simple/" || echo "https://pypi.org/simple") && \
    uv pip install --system --no-cache --break-system-packages \
    --index-url "$PYPI_URL" manim || \
    echo "⚠️  manim 安装失败（非致命），跳过"

# 第五批：PaddlePaddle
RUN ARCH=$(dpkg --print-architecture) && \
    if [ "$ARCH" = "amd64" ]; then \
        export HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= UV_CONCURRENT_DOWNLOADS=8 UV_HTTP_TIMEOUT=120 && \
        PYPI_URL=$([ "$USE_CN_MIRRORS" = "1" ] && echo "https://mirrors.aliyun.com/pypi/simple/" || echo "https://pypi.org/simple") && \
        uv pip install --system --no-cache --break-system-packages \
            --index-url "$PYPI_URL" \
            paddlepaddle paddleocr; \
    else \
        echo "⚠️  arm64: paddlepaddle 官方无预编译轮子，已跳过"; \
    fi

# 5. 浏览器固化
RUN if [ "$USE_CN_MIRRORS" = "1" ]; then \
        (export HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= PLAYWRIGHT_DOWNLOAD_HOST=https://registry.npmmirror.com/-/binary/playwright && \
         playwright install chromium --with-deps) || playwright install chromium --with-deps; \
    else \
        playwright install chromium --with-deps; \
    fi

# 5.5. 预装 OpenClaw 常用插件并固化到种子目录
RUN export HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= npm_config_proxy= npm_config_https_proxy= \
    FS_SAFE_NATIVE_MODE=auto OPENCLAW_FS_SAFE_NATIVE_MODE=auto && \
    if [ "$USE_CN_MIRRORS" = "1" ]; then \
        npm config set registry https://registry.npmmirror.com; \
    fi && \
    openclaw plugins install @openclaw/deepseek-provider --accept-capabilities --acknowledge-install-policy-warning --force && \
    openclaw plugins install @openclaw/memory-lancedb --accept-capabilities --acknowledge-install-policy-warning --force && \
    openclaw plugins install @tencent-weixin/openclaw-weixin --accept-capabilities --acknowledge-install-policy-warning --force && \
    openclaw plugins install @openclaw/tavily-plugin --accept-capabilities --acknowledge-install-policy-warning --force && \
    openclaw plugins install @openclaw/brave-plugin --accept-capabilities --acknowledge-install-policy-warning --force && \
    openclaw plugins install @openclaw/qwen-provider --accept-capabilities --acknowledge-install-policy-warning --force && \
    openclaw plugins install @openclaw/byteplus-provider --accept-capabilities --acknowledge-install-policy-warning --force && \
    openclaw plugins install @openclaw/moonshot-provider --accept-capabilities --acknowledge-install-policy-warning --force && \
    if [ -d /root/.openclaw/npm ]; then \
        mv /root/.openclaw/npm /app/plugins-seed && \
        rm -rf /root/.openclaw/* /root/.openclaw/.[!.]* 2>/dev/null || true; \
    else \
        echo "❌ OpenClaw plugins failed to install!" && exit 1; \
    fi

# 6. 最终权限审计与构建期预置底层兼容补丁
RUN chmod +x /usr/local/bin/duckdb 2>/dev/null || true && \
    chmod +x /usr/local/bin/dreamina 2>/dev/null || true && \
    chmod +x /usr/local/bin/jimeng 2>/dev/null || true && \
    ln -sf /app/openclaw.mjs /usr/local/bin/openclaw && \
    chmod +x /app/openclaw.mjs /usr/local/bin/openclaw && \
    mkdir -p /root/.openclaw /data && \
    chmod -R 777 /data && \
    chmod 1777 /tmp

COPY skills/ /app/workspace/skills/
RUN chmod -R 777 /app/workspace/skills

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh && \
    sed -n '/^# BEGIN_DIST_PATCH/,/^# END_DIST_PATCH/p' /usr/local/bin/entrypoint.sh | bash && \
    touch /app/.jimi_dist_patched

USER root
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
